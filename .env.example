# Copy this file to .env.local and replace every placeholder value.
# Do not commit real secrets. Keep production values in Vercel environment variables.

# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Clerk authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_placeholder"
CLERK_SECRET_KEY="sk_test_placeholder"

# Super admin bootstrap access. Regular admins are managed in the database.
SUPER_ADMIN_EMAILS="owner@example.com"

# Transactional email / contact forms
SMTP_HOST="smtp.example.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="smtp-user@example.com"
SMTP_PASS="smtp-password-placeholder"
CONTACT_FROM_EMAIL="noreply@example.com"
CONTACT_TO_EMAIL="support@example.com"

# Newsletter sync, optional unless Brevo is enabled
BREVO_API_KEY="xkeysib-placeholder"
BREVO_NEWSLETTER_LIST_ID="1"

# Currency conversion
EXCHANGE_RATE_API_KEY="exchange-rate-api-key-placeholder"

# Cloudflare R2 product image storage
R2_ACCOUNT_ID="cloudflare-account-id-placeholder"
R2_ACCESS_KEY_ID="r2-access-key-id-placeholder"
R2_SECRET_ACCESS_KEY="r2-secret-access-key-placeholder"
R2_BUCKET_NAME="equinemates-products-dev"
R2_PUBLIC_BASE_URL="https://pub-example.r2.dev"
R2_UPLOAD_PREFIX="products"
R2_MAX_UPLOAD_MB="4"
